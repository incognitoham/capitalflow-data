{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "presets.schema.json",
  "title": "CapitalFlow Presets",
  "type": "object",
  "required": ["version", "updated_at", "presets"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "annual_income"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": {
            "type": "object",
            "required": ["ja", "en"],
            "additionalProperties": false,
            "properties": {
              "ja": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          },
          "annual_income": {
            "type": "object",
            "required": ["amount_jpy", "source_currency", "is_estimated"],
            "additionalProperties": false,
            "properties": {
              "amount_jpy": { "type": "integer", "minimum": 0 },
              "source_currency": { "type": "string", "enum": ["jpy", "usd"] },
              "is_estimated": { "type": "boolean" },
              "note": { "type": "string" }
            }
          },
          "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "asset_name": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "emoji_fallback": { "type": "string" }
            }
          },
          "category": { "type": "string" }
        }
      }
    }
  }
}
